{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "swiss-qr-desktop",
    "version": "0.1.1",
    "identifier": "com.jacobmacweb.swiss-qr-desktop",
    "build": {
        "beforeDevCommand": "pnpm dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build",
        "frontendDist": "../dist"
    },
    "app": {
        "windows": [
            {
                "title": "Bills Manager",
                "width": 800,
                "height": 600,
                "label": "main"
            }
        ],
        "security": {
            "csp": null,
            "assetProtocol": {
                "enable": true,
                "scope": ["$APPDATA/bills/*", "$APPDATA/bills/**"]
            }
        }
    },
    "plugins": {
        "updater": {
            "endpoints": [
                "https://github.com/mwja/ch-qr-bill/releases/latest/download/latest.json"
            ],
            "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRBOEM0NTg2QkREQzRCRUEKUldUcVM5eTloa1dNU2pRKys1cTMzc3FFVk5HdnV3Kyt4TmpJZFc5YjA0cFR4aVpLMjdaTkVNRUMK"
        }
    },
    "bundle": {
        "active": true,
        "createUpdaterArtifacts": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
